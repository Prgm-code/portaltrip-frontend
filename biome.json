{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!vercel.json",
      "!!**/dist",
      "!!**/.astro",
      "!!**/.pnpm-store",
      "!!**/.vercel",
      "!!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
