---
import { messages, resolveAstroLocale } from 'i18n';

interface Props {
  class?: string;
  label?: string;
}

const locale = resolveAstroLocale(Astro.currentLocale, Astro.url.pathname);
const { class: className = '', label = messages[locale].uplink.label } = Astro.props;
---

<span class:list={['uplink', className]} data-uplink="online" role="status">
  <i aria-hidden="true"></i>
  <span>{label}</span>
  <span data-uplink-state>{messages[locale].uplink.online}</span>
</span>
<script>
import { msg } from 'i18n';
import { checkHealth } from 'services/portalTripApi';

// El HUD combina la señal del navegador con el healthcheck real de PortalTrip API.
let apiOnline = true;

function paintUplink(): void {
  const browserOnline = navigator.onLine;
  const online = browserOnline && apiOnline;
  const copy = msg().uplink;
  document.querySelectorAll<HTMLElement>('[data-uplink]').forEach((node) => {
    node.dataset.uplink = online ? 'online' : 'offline';
    const state = node.querySelector('[data-uplink-state]');
    if (state)
      state.textContent = online ? copy.online : browserOnline ? copy.citadelDown : copy.offline;
  });
}

async function probeUplink(): Promise<void> {
  apiOnline = navigator.onLine ? await checkHealth() : false;
  paintUplink();
}

window.addEventListener('online', () => void probeUplink());
window.addEventListener('offline', paintUplink);
document.addEventListener('astro:after-swap', paintUplink);
document.addEventListener('astro:page-load', () => void probeUplink());
void probeUplink();
</script>
