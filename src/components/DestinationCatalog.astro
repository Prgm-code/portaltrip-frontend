---
import { IconSearch } from '@tabler/icons-astro';
import { messages, resolveAstroLocale } from 'i18n';
import 'styles/catalog.css';

const copy = messages[resolveAstroLocale(Astro.currentLocale, Astro.url.pathname)];
---

<section
  id="destinos"
  class="view-panel glass"
  data-panel="destinations"
  role="tabpanel"
  aria-labelledby="destinations-tab"
>
  <div class="catalog-heading">
    <div>
      <span class="section-kicker">{copy.catalog.kicker}</span>
      <h2 class="section-title">{copy.catalog.title}</h2>
    </div>
    <p class="live-note"><i aria-hidden="true"></i> {copy.catalog.live}</p>
  </div>

  <div class="catalog-tools">
    <label class="search-box">
      <IconSearch size={17} stroke={1.9} aria-hidden="true" />
      <span class="sr-only">{copy.catalog.search}</span>
      <input
        class="control"
        id="location-search"
        type="search"
        placeholder={copy.catalog.searchPlaceholder}
      >
    </label>
    <label class="filter-box">
      <span class="sr-only">{copy.catalog.filterType}</span>
      <select class="control" id="type-filter">
        <option value="all">{copy.catalog.allTypes}</option>
        <option value="Planet">{copy.catalog.types.Planet}</option>
        <option value="Space station">{copy.catalog.types['Space station']}</option>
        <option value="Dimension">{copy.catalog.types.Dimension}</option>
        <option value="Microverse">{copy.catalog.types.Microverse}</option>
        <option value="TV">{copy.catalog.types.TV}</option>
      </select>
    </label>
  </div>

  <div id="catalog-status" class="catalog-status" aria-live="polite"></div>
  <div id="destination-grid" class="destination-grid"></div>

  <nav class="pagination" aria-label={copy.catalog.pagination}>
    <button class="page-btn" id="previous-page" type="button" aria-label={copy.catalog.previous}>
      ←
    </button>
    <span id="page-status">{copy.catalog.page(1, 1)}</span>
    <button class="page-btn" id="next-page" type="button" aria-label={copy.catalog.next}>→</button>
  </nav>
</section>
