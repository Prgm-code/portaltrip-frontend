---
import { IconUniverse } from '@tabler/icons-astro';
import { localizedPath, messages, resolveAstroLocale } from 'i18n';

interface Props {
  href?: string;
  class?: string;
  /** Solo una instancia por página puede compartir la transición de vista. */
  shared?: boolean;
}

const locale = resolveAstroLocale(Astro.currentLocale, Astro.url.pathname);
const { href = localizedPath(locale, '/'), class: className = '', shared = false } = Astro.props;
---

<a
  class:list={['portal-logo', shared && 'shared', className]}
  href={href}
  aria-label={messages[locale].brand.home}
>
  <span class="portal-logo-mark" aria-hidden="true">
    <span class="portal-logo-glow"></span>
    <IconUniverse size={24} stroke={1.65} color="var(--green)" />
    <span class="portal-logo-dot"></span>
  </span>
  <span class="portal-logo-text">PORTAL<span>TRIP</span></span>
</a>
