---
import { messages, resolveAstroLocale } from 'i18n';

const locale = resolveAstroLocale(Astro.currentLocale, Astro.url.pathname);
const copy = messages[locale];
---

<dialog
  id="passport-dialog"
  class="passport-dialog glass"
  data-passport-scope
  data-passport-mode="login"
  aria-labelledby="passport-dialog-title"
>
  <div class="passport-dialog-body">
    <button class="modal-close" type="button" data-close-passport aria-label={copy.passport.close}>
      ×
    </button>
    <span class="section-kicker">{copy.passport.kicker}</span>
    <h2 id="passport-dialog-title" data-passport-title>{copy.passport.login.title}</h2>
    <p class="passport-copy" data-passport-copy>
      {copy.passport.login.copy}
    </p>

    <div class="view-tabs passport-tabs" role="tablist" aria-label={copy.passport.tabs}>
      <button
        class="view-tab active"
        type="button"
        role="tab"
        aria-selected="true"
        data-passport-mode="login"
      >
        {copy.passport.tabLogin}
      </button>
      <button
        class="view-tab"
        type="button"
        role="tab"
        aria-selected="false"
        data-passport-mode="register"
      >
        {copy.passport.tabRegister}
      </button>
    </div>

    <form id="passport-form" novalidate data-astro-reload>
      <p class="credit-badge" data-register-only>
        <span aria-hidden="true">✦</span>
        {copy.passport.welcomeCredits}
      </p>
      <label class="field" data-register-only>
        <span class="field-label">{copy.booking.fullName}</span>
        <input
          class="control"
          name="fullName"
          type="text"
          autocomplete="name"
          placeholder={copy.passport.namePlaceholder}
        >
      </label>
      <label class="field">
        <span class="field-label">{copy.booking.email}</span>
        <input
          class="control"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="morty@email.com"
        >
      </label>
      <label class="field">
        <span class="field-label"
          >{copy.booking.password} <small>{copy.booking.passwordHint}</small></span
        >
        <span class="password-field">
          <input
            class="control"
            name="password"
            type="password"
            autocomplete="current-password"
            minlength="8"
            maxlength="64"
          >
          <button class="password-toggle" type="button" data-toggle-password aria-pressed="false">
            {copy.booking.showPassword}
          </button>
        </span>
      </label>
      <div class="form-errors" data-passport-errors role="alert" hidden></div>
      <button class="btn btn-primary submit-btn" type="submit">
        <span data-passport-submit>{copy.passport.login.submit}</span
        ><span aria-hidden="true">→</span>
      </button>
    </form>
  </div>
</dialog>
