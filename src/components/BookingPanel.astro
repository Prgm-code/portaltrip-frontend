---
import { IconRoute, IconShieldCheck } from '@tabler/icons-astro';
import { formatCredits, messages, resolveAstroLocale } from 'i18n';
import { RiskLevel } from 'models/reservation';
import 'styles/booking-dynamic.css';
import { INSURANCE_PRICE } from 'utils/travelRules';

const locale = resolveAstroLocale(Astro.currentLocale, Astro.url.pathname);
const copy = messages[locale];
---

<aside class="booking-card glass" id="reserva">
  <div class="booking-heading">
    <div class="booking-icon" aria-hidden="true">
      <IconRoute size={22} stroke={1.7} />
    </div>
    <div>
      <span class="section-kicker" data-booking-kicker>{copy.booking.kickerStep1}</span>
      <h2>{copy.booking.title}</h2>
    </div>
  </div>

  <form id="booking-form" aria-describedby="booking-api-status" novalidate>
    <div id="booking-api-status" class="console-status" aria-live="assertive" hidden></div>

    <label class="field">
      <span class="field-label">{copy.booking.passengerName}</span>
      <input
        class="control"
        id="passengerName"
        name="passengerName"
        type="text"
        autocomplete="name"
        placeholder={copy.booking.passengerPlaceholder}
        required
      >
    </label>

    <label class="field">
      <span class="field-label">{copy.booking.destination}</span>
      <select class="control" id="destinationId" name="destinationId" required>
        <option value="">{copy.catalog.selectDestination}</option>
      </select>
    </label>

    <div id="destination-hint" class="destination-hint" hidden></div>

    <div class="field-row">
      <label class="field">
        <span class="field-label">{copy.booking.travelDate}</span>
        <input class="control" id="travelDate" name="travelDate" type="date" required>
      </label>
      <label class="field">
        <span class="field-label">{copy.booking.passengers}</span>
        <span class="stepper">
          <button type="button" data-step="-1" aria-label={copy.booking.minusPassenger}>−</button>
          <input id="passengers" name="passengers" type="number" min="1" max="8" value="1" readonly>
          <button type="button" data-step="1" aria-label={copy.booking.plusPassenger}>+</button>
        </span>
      </label>
    </div>

    <fieldset class="fieldset">
      <legend>
        <span>{copy.booking.crew} <small class="legend-note">{copy.booking.crewNote}</small></span>
        <b id="companion-status">0 / 3</b>
      </legend>
      <div id="companion-grid" class="companion-grid" aria-live="polite">
        <p>{copy.booking.crewEmpty}</p>
      </div>
    </fieldset>

    <fieldset class="fieldset">
      <legend><span>{copy.booking.tripType}</span></legend>
      <div class="choice-grid">
        <label class="choice">
          <input type="radio" name="tripType" value="express" checked>
          <span><b>{copy.booking.express}</b><small>{copy.booking.expressHint}</small></span>
        </label>
        <label class="choice">
          <input type="radio" name="tripType" value="exploration">
          <span
            ><b>{copy.booking.exploration}</b><small>{copy.booking.explorationHint}</small></span
          >
        </label>
        <label class="choice">
          <input type="radio" name="tripType" value="premium">
          <span><b>{copy.booking.premium}</b><small>{copy.booking.premiumHint}</small></span>
        </label>
      </div>
    </fieldset>

    <label class="toggle-row">
      <span class="toggle">
        <input id="insurance" name="insurance" type="checkbox">
        <i class="toggle-track" aria-hidden="true"></i>
      </span>
      <span class="toggle-copy">
        <b>{copy.booking.insurance}</b>
        <small id="insurance-copy">{copy.booking.insuranceOptional}</small>
      </span>
      <strong class="toggle-price"
        >+ {formatCredits(INSURANCE_PRICE, locale)} {copy.booking.perPerson}</strong
      >
    </label>

    <label class="field">
      <span class="field-label"
        >{copy.booking.comments} <small>{copy.booking.optional}</small></span
      >
      <textarea
        class="control"
        id="comments"
        name="comments"
        rows="2"
        maxlength="240"
        placeholder={copy.booking.commentsPlaceholder}
      ></textarea>
    </label>

    <section
      id="passport-step"
      class="passport-step"
      data-passport-scope
      data-passport-mode="register"
      aria-labelledby="passport-step-title"
      hidden
    >
      <div class="passport-step-head">
        <span class="section-kicker">{copy.booking.kickerStep2}</span>
        <h3 id="passport-step-title" data-passport-step-title>
          {copy.booking.stepRegisterTitle}
        </h3>
        <p class="credit-badge" data-register-only>
          <span aria-hidden="true">✦</span>
          {copy.passport.welcomeCredits}
        </p>
      </div>
      <label class="field" data-register-only>
        <span class="field-label">{copy.booking.fullName}</span>
        <input
          class="control"
          id="fullName"
          name="fullName"
          type="text"
          autocomplete="name"
          placeholder={copy.booking.fullNamePlaceholder}
        >
      </label>
      <label class="field">
        <span class="field-label">{copy.booking.email}</span>
        <input
          class="control"
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="morty@email.com"
        >
      </label>
      <label class="field">
        <span class="field-label"
          >{copy.booking.password} <small>{copy.booking.passwordHint}</small></span
        >
        <span class="password-field">
          <input
            class="control"
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="64"
          >
          <button class="password-toggle" type="button" data-toggle-password aria-pressed="false">
            {copy.booking.showPassword}
          </button>
        </span>
      </label>
      <p class="passport-switch">
        <button type="button" data-passport-switch data-passport-mode="login">
          {copy.passport.register.switchLabel}
        </button>
      </p>
    </section>

    <div id="form-errors" class="form-errors" role="alert" hidden></div>

    <div class="quote-grid">
      <div class="quote-tile">
        <span>{copy.booking.risk}</span>
        <strong id="risk-value" class="risk alto"
          ><i></i> {copy.labels.risk[RiskLevel.HIGH]}</strong
        >
      </div>
      <div class="quote-tile">
        <span>{copy.booking.jumpCost}</span>
        <strong id="price-value">{formatCredits(1200, locale)}</strong>
      </div>
      <div class="quote-tile balance-tile" id="balance-tile" hidden>
        <span>{copy.booking.balanceAfter}</span>
        <strong id="balance-value">{formatCredits(0, locale)}</strong>
      </div>
    </div>

    <button class="btn btn-primary submit-btn" id="confirm-booking" type="submit">
      <span>{copy.booking.submitRegister}</span><span aria-hidden="true">→</span>
    </button>
    <p class="submit-note">
      <IconShieldCheck size={13} stroke={1.9} aria-hidden="true" />
      <span>{copy.booking.noteAnonymous}</span>
    </p>
  </form>
</aside>
