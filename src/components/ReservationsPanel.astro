---
import 'styles/reservations-dynamic.css';
---

<section
  class="view-panel reservations-panel glass"
  data-panel="reservations"
  role="tabpanel"
  aria-labelledby="reservations-tab"
  hidden
>
  <div class="catalog-heading">
    <div>
      <span class="section-kicker">Bitácora de viaje</span>
      <h2 class="section-title">Mis reservas</h2>
    </div>
    <p class="live-note"><i aria-hidden="true"></i> Sincronizadas con la Ciudadela</p>
  </div>
  <div id="legacy-notice" hidden></div>
  <div id="reservations-list" class="reservations-list"></div>
</section>
