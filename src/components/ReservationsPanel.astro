---
import { messages, resolveAstroLocale } from 'i18n';
import 'styles/reservations-dynamic.css';

const copy = messages[resolveAstroLocale(Astro.currentLocale, Astro.url.pathname)];
---

<section
  class="view-panel reservations-panel glass"
  data-panel="reservations"
  role="tabpanel"
  aria-labelledby="reservations-tab"
  hidden
>
  <div class="catalog-heading">
    <div>
      <span class="section-kicker">{copy.reservations.kicker}</span>
      <h2 class="section-title">{copy.reservations.title}</h2>
    </div>
    <p class="live-note"><i aria-hidden="true"></i> {copy.reservations.live}</p>
  </div>
  <div id="legacy-notice" hidden></div>
  <div id="reservations-list" class="reservations-list"></div>
</section>
