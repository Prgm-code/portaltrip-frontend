---
import {
  IconArrowRight,
  IconCoins,
  IconPlanet,
  IconShieldCheck,
  IconUsers,
} from '@tabler/icons-astro';
import BookingPanel from 'components/BookingPanel.astro';
import DestinationCatalog from 'components/DestinationCatalog.astro';
import Header from 'components/Header.astro';
import Portal from 'components/Portal.astro';
import ReservationsPanel from 'components/ReservationsPanel.astro';
import SiteFooter from 'components/SiteFooter.astro';
import Layout from 'layouts/Layout.astro';
import 'styles/home.css';
---

<Layout>
  <Header />

  <main class="shell">
    <section class="hero" aria-label="Portal interdimensional">
      <div class="hero-copy">
        <span class="hud-label"
          ><i aria-hidden="true"></i>
          Agencia interdimensional certificada</span
        >
        <h1 id="hero-title">
          Elige tu dimensión.<br>
          <span class="hero-accent" data-text="Nosotros abrimos el portal."
            >Nosotros abrimos el portal.</span
          >
        </h1>
        <p class="hero-lead">
          Salidas diarias desde la Tierra C-137 a planetas, estaciones y dimensiones fuera de este
          mundo. Tú eliges el destino; nosotros calculamos el riesgo y estabilizamos la conexión.
        </p>

        <!-- Invitación al pasaporte: los créditos de bienvenida pagan el primer salto. -->
        <aside
          class="credit-invite glass"
          data-session-anonymous
          aria-label="Créditos de bienvenida"
        >
          <div class="invite-badge">
            <span aria-hidden="true">✦</span>
            <b>5.000 CR</b>
            <small>de regalo</small>
          </div>
          <div class="invite-copy">
            <b>Tu primer salto lo paga la Ciudadela</b>
            <p>
              Crea tu pasaporte gratis y recibe 5.000 créditos de bienvenida. Alcanzan para
              cualquier ruta express o de exploración.
            </p>
          </div>
          <div class="invite-actions">
            <button class="btn btn-primary" type="button" data-open-passport="register">
              Crear pasaporte gratis
              <IconArrowRight size={16} stroke={2.2} aria-hidden="true" />
            </button>
            <button class="btn btn-ghost" type="button" data-open-passport="login">
              Ya tengo pasaporte
            </button>
          </div>
        </aside>

        <aside
          class="credit-invite glass active"
          data-session-authenticated
          aria-label="Saldo del pasaporte"
          hidden
        >
          <div class="invite-badge">
            <span aria-hidden="true">◎</span>
            <b data-account-balance>0 CR</b>
            <small>disponibles</small>
          </div>
          <div class="invite-copy">
            <b>Pasaporte activo, <span data-account-name>viajero</span></b>
            <p>Tus créditos están listos. Elige un destino y confirma el salto en un solo paso.</p>
          </div>
          <div class="invite-actions">
            <a class="btn btn-primary" href="#destinos">
              Elegir destino
              <IconArrowRight size={16} stroke={2.2} aria-hidden="true" />
            </a>
            <a class="btn btn-ghost" href="/#destinos" data-open-reservations>Mis reservas</a>
          </div>
        </aside>

        <ul class="hero-stats" aria-label="Protocolos de viaje">
          <li><IconPlanet size={16} stroke={1.8} aria-hidden="true" /> Riesgo calculado en vivo</li>
          <li>
            <IconUsers size={16} stroke={1.8} aria-hidden="true" />
            Hasta tres acompañantes vivos
          </li>
          <li>
            <IconShieldCheck size={16} stroke={1.8} aria-hidden="true" />
            Seguro interdimensional
          </li>
          <li>
            <IconCoins size={16} stroke={1.8} aria-hidden="true" />
            Cancelación con reembolso
          </li>
        </ul>
      </div>

      <div class="hero-visual">
        <Portal size="clamp(240px, 30vw, 400px)" />
        <section class="hero-readout glass" aria-label="Coordenadas del portal">
          <span class="hud-label">Coordenadas</span>
          <code>ORIGEN · TIERRA C-137</code>
          <code class="dim">DESTINO · PENDIENTE</code>
          <code class="passport-readout" data-readout-passport hidden></code>
        </section>
        <div class="credit-chip hero-credit">
          <span>Misión avalada por</span>
          <span class="logo-plate">
            <img
              src="https://desafiolatam.com/logo-real.png"
              width="345"
              height="142"
              alt="Desafío Latam"
              fetchpriority="high"
            >
          </span>
        </div>
      </div>
    </section>

    <!-- Buscador de salto al estilo de un mostrador de aerolínea. -->
    <section class="search-deck glass" aria-labelledby="deck-title">
      <form id="search-deck" class="deck-form" novalidate>
        <div class="deck-field deck-origin">
          <span class="deck-label">Origen</span>
          <strong>Tierra C-137</strong>
          <small>Terminal Ciudadela</small>
        </div>
        <label class="deck-field">
          <span class="deck-label" id="deck-title">Destino</span>
          <select class="control" id="deck-destination" name="destinationId">
            <option value="">Elige una coordenada</option>
          </select>
        </label>
        <label class="deck-field">
          <span class="deck-label">Fecha del salto</span>
          <input class="control" id="deck-date" name="travelDate" type="date">
        </label>
        <div class="deck-field">
          <span class="deck-label">Pasajeros</span>
          <span class="stepper">
            <button type="button" data-deck-step="-1" aria-label="Restar pasajero">−</button>
            <input
              id="deck-passengers"
              name="passengers"
              type="number"
              min="1"
              max="8"
              value="1"
              readonly
              aria-label="Cantidad de pasajeros"
            >
            <button type="button" data-deck-step="1" aria-label="Sumar pasajero">+</button>
          </span>
        </div>
        <button class="btn btn-primary deck-submit" type="submit">
          Buscar tarifa
          <IconArrowRight size={16} stroke={2.2} aria-hidden="true" />
        </button>
      </form>
      <p class="deck-note">
        <span><i aria-hidden="true"></i> Cotización instantánea</span>
        <span>Cobro en créditos del pasaporte</span>
        <span>Cancelación con reembolso total</span>
      </p>
    </section>

    <!-- Rutas destacadas: tarifas de salida como en un panel de ofertas. -->
    <section class="featured" aria-labelledby="featured-title">
      <div class="catalog-heading">
        <div>
          <span class="section-kicker">Rutas destacadas</span>
          <h2 id="featured-title" class="section-title">Ofertas del multiverso</h2>
        </div>
        <p class="live-note"><i aria-hidden="true"></i> Tarifa express · 1 pasajero</p>
      </div>
      <div id="featured-routes" class="featured-routes" aria-live="polite"></div>
    </section>

    <section class="workspace" aria-label="Planificador de viajes">
      <div class="catalog-column">
        <div class="view-tabs" role="tablist" aria-label="Secciones">
          <button
            type="button"
            class="view-tab active"
            id="destinations-tab"
            data-view="destinations"
            role="tab"
            aria-selected="true"
          >
            Explorar destinos
          </button>
          <button
            type="button"
            class="view-tab"
            id="reservations-tab"
            data-view="reservations"
            role="tab"
            aria-selected="false"
          >
            Mis reservas
            <span id="reservation-count" class="tab-count">0</span>
          </button>
        </div>
        <DestinationCatalog />
        <ReservationsPanel />
      </div>
      <BookingPanel />
    </section>
  </main>

  <SiteFooter />

  <script>
  import 'scripts/app';
  </script>
</Layout>
