---
import { ClientRouter } from 'astro:transitions';
import PassportDialog from 'components/PassportDialog.astro';
import StarField from 'components/StarField.astro';
import {
  defaultLocale,
  localizedPath,
  messages,
  resolveAstroLocale,
  stripLocalePrefix,
} from 'i18n';
import 'styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const locale = resolveAstroLocale(Astro.currentLocale, Astro.url.pathname);
const copy = messages[locale];
const { title = copy.meta.title } = Astro.props;
const description = Astro.props.description ?? copy.meta.description;
const path = stripLocalePrefix(Astro.url.pathname);
const origin = Astro.url.origin;
const homeHref = localizedPath(locale, '/');
---

<!doctype html>
<html
  class="scroll-smooth"
  lang={locale}
  data-session="anonymous"
  data-locale={locale}
  data-home={homeHref}
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator}>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#040a07">
    <link
      rel="alternate"
      hreflang={defaultLocale}
      href={`${origin}${localizedPath(defaultLocale, path)}`}
    >
    <link rel="alternate" hreflang="en" href={`${origin}${localizedPath('en', path)}`}>
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${origin}${localizedPath(defaultLocale, path)}`}
    >
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen min-w-80 overflow-x-hidden">
    <div class="void-layer" aria-hidden="true"></div>
    <StarField />
    <div class="crt-layer" aria-hidden="true" transition:persist="crt-layer">
      <span class="scanline"></span>
    </div>
    <div class="jump-flash" aria-hidden="true" transition:persist="jump-flash"></div>
    <slot />
    <PassportDialog />
    <div id="toast-region" class="toast-region" aria-live="polite"></div>
    <script>
    import 'scripts/portal-jump';
    import 'scripts/session-hud';
    </script>
  </body>
</html>
